# Web3Forms access key for the contact form.
# NEXT_PUBLIC_ means this is inlined into the client bundle at build time and
# is visible to anyone who views source - that is how Web3Forms works, the key
# identifies the destination inbox rather than authorising anything. Still kept
# out of git so the repo does not carry account-specific config.
# Get one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=
